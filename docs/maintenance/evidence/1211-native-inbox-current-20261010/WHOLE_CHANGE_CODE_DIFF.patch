+  readonly abort: AbortController
+  readonly response: Promise<Response>
+}
+
+function controlledFetch(
+  app: { fetch(request: Request): Response | Promise<Response> },
+  request: Request,
+): Promise<Response> {
+  return Promise.resolve(app.fetch(request))
+}
