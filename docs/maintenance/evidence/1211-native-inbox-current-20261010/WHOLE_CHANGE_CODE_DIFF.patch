+/** Causal mocked-SDK controls for native Claude Code Agent identity and cancellation. */
+import { afterAll, afterEach, beforeEach, describe, expect, it } from "bun:test"
+import { mkdtempSync, mkdirSync, rmSync } from "node:fs"
