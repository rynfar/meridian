+      [{ role: "user", content: [{ type: "tool_result", tool_use_id: "read-1", content: PROGRESS_PROMPT }] }],
+      [{ role: "user", content: [
+        { type: "text", text: PROGRESS_PROMPT },
+        { type: "text", text: "Now edit the file." },
