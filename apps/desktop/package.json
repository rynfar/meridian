{
  "name": "meridian-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Native desktop manager for Meridian",
  "author": "rynfar",
  "license": "MIT",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "tsc --noEmit && node build.mjs",
    "start": "npm run build && electron .",
    "package:mac": "npm run build && electron-builder --mac --dir --publish never"
  },
  "dependencies": {
    "node": "22.23.2",
    "npm": "11.19.1"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  },
  "build": {
    "appId": "dev.meridian.desktop",
    "productName": "Meridian Desktop",
    "asar": false,
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "dist/icon.png",
      "target": [
        "dmg"
      ],
      "hardenedRuntime": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "dist/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "dist/icon.png"
    }
  },
  "optionalDependencies": {
    "electron-liquid-glass": "1.1.1"
  }
}
