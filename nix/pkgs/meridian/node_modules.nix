{
  bun,
  lib,
  pname,
  src,
  stdenvNoCC,
  version,
  writableTmpDirAsHomeHook,
}:
let
  inherit (lib.cli) toCommandLineShellGNU;
  installFlags = {
    cpu = "*";
    frozen-lockfile = true;
    ignore-scripts = true;
    linker = "hoisted";
    no-progress = true;
    os = "*";
  };
in
stdenvNoCC.mkDerivation {
  name = "${pname}-node_modules";
  inherit src version;

  nativeBuildInputs = [
    bun
    writableTmpDirAsHomeHook
  ];

  impureEnvVars = lib.fetchers.proxyImpureEnvVars;

  dontConfigure = true;

  buildPhase = ''
    runHook preBuild

    export BUN_INSTALL_CACHE_DIR=$(mktemp -d)

    bun install ${toCommandLineShellGNU { } installFlags}
    mkdir build
    mv node_modules build/

    bun install ${toCommandLineShellGNU { } (installFlags // { production = true; })}
    mkdir runtime
    mv node_modules runtime/

    runHook postBuild
  '';

  installPhase = ''
    runHook preInstall

    mkdir -p $out
    for tree in build runtime; do
      rm -rf $tree/node_modules/@anthropic-ai/{claude-code,claude-code-*,claude-agent-sdk-*} \
        $tree/node_modules/.bin/claude
      cp -R $tree $out/
    done

    runHook postInstall
  '';

  dontFixup = true;

  outputHash = "sha256-oH6dWbRTdNQeXEA6rtU2oW/OJPT+UoXnUfajhgQgybs=";
  outputHashAlgo = "sha256";
  outputHashMode = "recursive";
}
